# Public HTTPS origin that QR codes point to (no trailing slash). REQUIRED in production.
PUBLIC_BASE_URL=https://diwali.example.com
# Admin token for /admin. If unset, one is generated and stored in data/.admin-token
ADMIN_TOKEN=change-me-to-a-long-random-string
PORT=8080
# Where canvases.json and compiled targets live (mount a persistent volume here)
DATA_DIR=./data
# HTTPS=1 starts an extra self-signed HTTPS server on HTTPS_PORT (LAN phone testing only)
# HTTPS=1
# HTTPS_PORT=8443
