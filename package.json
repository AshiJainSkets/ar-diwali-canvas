{
  "name": "ar-diwali-canvas",
  "version": "1.0.0",
  "description": "Web AR that paints a Diwali artwork onto a physical 4x3 ft canvas \u2014 no app install.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js --https",
    "compile:target": "node tools/compile-target.mjs",
    "gallery:build": "python3 tools/paintings/build_gallery.py",
    "test:e2e": "bash tools/e2e/run_all.sh"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "nanoid": "^3.3.20",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1"
  },
  "private": true,
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "playwright": "^1.48.0"
  }
}